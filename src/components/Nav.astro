---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Home" },
  { href: "/what-we-do", label: "What We Do" },
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
];

const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="brand" aria-label="Kaizen Blue — home">
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
        <defs>
          <linearGradient id="navmark" x1="0" y1="32" x2="32" y2="0">
            <stop offset="0" stop-color="#2563eb"></stop>
            <stop offset="1" stop-color="#7cabff"></stop>
          </linearGradient>
        </defs>
        <rect x="2" y="19" width="6" height="9" rx="1.8" fill="url(#navmark)"></rect>
        <rect x="11" y="11" width="6" height="17" rx="1.8" fill="url(#navmark)"></rect>
        <rect x="20" y="3" width="6" height="25" rx="1.8" fill="url(#navmark)"></rect>
      </svg>
      <span>Kaizen <span class="blue">Blue</span></span>
    </a>

    <button class="nav__toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round"></path>
      </svg>
    </button>

    <nav class="nav__menu" id="navMenu">
      <ul class="nav__links">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav__cta">
        <a href="/contact" class="btn btn--primary">Talk to us</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("navToggle");
  const menu = document.getElementById("navMenu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>
