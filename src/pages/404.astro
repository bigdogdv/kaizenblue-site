---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — Kaizen Blue" description="That page doesn't exist.">
  <section class="section" style="padding-top:96px">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1 class="h1" style="margin-top:14px">This page got away from us.</h1>
      <p class="lead pagehead__intro">
        The link's broken or the page moved. Let's get you back on track.
      </p>
      <div class="hero__cta">
        <a href="/" class="btn btn--primary btn--lg">
          Back home <span class="arrow">&rarr;</span>
        </a>
        <a href="/what-we-do" class="btn btn--ghost btn--lg">What we do</a>
      </div>
    </div>
  </section>
</Base>
