---
import Base from "../layouts/Base.astro";
---

<Base
  title="Contact — Kaizen Blue"
  description="Get in touch with Kaizen Blue. Email contact@kaizenblue.io. Based at Marina Bay Financial Centre, Singapore."
>
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1 class="h1">Let's talk.</h1>
      <p class="lead pagehead__intro">
        Whether you're sizing up a problem, looking for a second opinion on a
        decision, or you've already got a plan that needs an operator — send a
        note. No pitch deck, no qualifying call. You'll hear back from the
        person who would lead the work.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="contact-grid">
        <div class="contact-card">
          <span class="eyebrow">Email</span>
          <a class="contact-card__value" href="mailto:contact@kaizenblue.io">
            contact@kaizenblue.io
          </a>
        </div>

        <div class="contact-card">
          <span class="eyebrow">Singapore</span>
          <address class="contact-card__value" style="font-style:normal">
            Level 39, Marina Bay Financial Centre<br />
            Tower 2, 10 Marina Boulevard<br />
            Singapore 018982
          </address>
        </div>

        <div class="contact-card">
          <span class="eyebrow">LinkedIn</span>
          <a
            class="contact-card__value"
            href="https://www.linkedin.com/in/davincidaniel"
            rel="noopener"
            target="_blank"
          >
            linkedin.com/in/davincidaniel
          </a>
        </div>
      </div>

      <div style="margin-top:34px">
        <a href="mailto:contact@kaizenblue.io" class="btn btn--primary btn--lg">
          Email us <span class="arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>
