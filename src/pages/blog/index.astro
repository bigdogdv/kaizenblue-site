---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

const upcoming = [
  {
    title: "Your SAP transformation is actually an AI opportunity.",
    desc: "Why the companies running S/4HANA migrations right now should be designing AI into the new platform, not bolting it on two years later.",
  },
  {
    title: "What actually works with enterprise AI.",
    desc: "An honest read of which AI patterns deliver value at scale, which look great in pilots and die in production, and where the cost-to-value lines really sit.",
  },
  {
    title: "Six acquisitions in two years: what we learned about technology M&A.",
    desc: "Hard-won lessons from integrating six companies across five continents into a single global practice, from diligence through cultural integration.",
  },
];
---

<Base
  title="Blog — Kaizen Blue"
  description="Field notes on enterprise technology, cloud, and AI — written from inside the engagement, not from an analyst's seat."
>
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow">Field notes</span>
      <h1 class="h1">From the work.</h1>
      <p class="lead pagehead__intro">
        Enterprise technology, cloud, and AI. Written from inside the
        engagement, not from an analyst's seat.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      {
        posts.length > 0 ? (
          <div class="posts">
            {posts.map((post) => (
              <a href={`/blog/${post.id}/`} class="post-row">
                <div class="post-row__date">{dateFmt(post.data.date)}</div>
                <div class="post-row__title">{post.data.title}</div>
                <div class="post-row__desc">{post.data.description}</div>
              </a>
            ))}
          </div>
        ) : (
          <>
            <div class="empty">
              <h2 class="h3">Nothing published yet.</h2>
              <p>
                The first pieces are being written. Here's what's on the way —
                no fluff, no thought-leadership theatre.
              </p>
            </div>
            <div class="topics">
              {upcoming.map((t) => (
                <div class="topics__item">
                  <span class="topics__tag">Coming soon</span>
                  <div class="topics__title">{t.title}</div>
                  <div class="topics__desc">{t.desc}</div>
                </div>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</Base>
