---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

const upcoming = [
  {
    title: "Your SAP Transformation Is Actually an AI Opportunity",
    desc: "Why companies doing S/4HANA migrations right now should be thinking about AI at the same time, not as a separate initiative.",
  },
  {
    title: "I Use AI Every Day. Here's What Actually Works in Enterprise.",
    desc: "Honest take on what AI tools and approaches deliver real value vs what's still hype. Written from hands-on experience, not analyst reports.",
  },
  {
    title: "Six Acquisitions in Two Years: What I Learned About Technology M&A",
    desc: "Hard-won lessons from integrating six companies across five continents into a single global practice.",
  },
];
---

<Base
  title="Blog — Kaizen Blue"
  description="Notes on enterprise technology, cloud, and AI — from hands-on work, not analyst reports."
>
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow">Blog</span>
      <h1 class="h1">Notes from the work.</h1>
      <p class="lead pagehead__intro">
        Enterprise technology, cloud, and AI &mdash; written from hands-on
        experience, not analyst reports.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      {
        posts.length > 0 ? (
          <div class="posts">
            {posts.map((post) => (
              <a href={`/blog/${post.id}/`} class="post-row">
                <div class="post-row__date">{dateFmt(post.data.date)}</div>
                <div class="post-row__title">{post.data.title}</div>
                <div class="post-row__desc">{post.data.description}</div>
              </a>
            ))}
          </div>
        ) : (
          <>
            <div class="empty">
              <h2 class="h3">Nothing published yet.</h2>
              <p>
                First pieces are being written. Here's what's on the way &mdash;
                no fluff, just the things worth saying.
              </p>
            </div>
            <div class="topics">
              {upcoming.map((t) => (
                <div class="topics__item">
                  <span class="topics__tag">Coming soon</span>
                  <div class="topics__title">{t.title}</div>
                  <div class="topics__desc">{t.desc}</div>
                </div>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</Base>
