---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kaizen Blue — Enterprise technology that actually works",
  description = "Strategy, transformation, and AI for enterprise. Real execution, real outcomes. Founded by Daniel Da Vinci. Based in Singapore.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://kaizenblue.io");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#070b14" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Kaizen Blue" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
